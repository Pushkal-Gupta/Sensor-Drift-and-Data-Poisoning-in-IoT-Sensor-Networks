{
  "version": 1,
  "author": "Shridhar M (23BCT0201), Vanka Kaushik, Pushkal Gupta - PIRRD edge node",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-dht22", "id": "dht", "top": 60, "left": -180,
      "attrs": { "temperature": "24.0", "humidity": "45" } },
    { "type": "wokwi-resistor", "id": "rPullup", "top": 20, "left": -175, "rotate": 90,
      "attrs": { "value": "10000" } },
    { "type": "wokwi-text", "id": "lbl", "top": -40, "left": -190,
      "attrs": { "text": "DHT22 - 10k pull-up on data" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],

    [ "dht:VCC", "esp:3V3",   "red",    [ "v-30", "h60", "*", "h-20" ] ],
    [ "dht:GND", "esp:GND.1", "black",  [ "v30", "h140", "*", "h-20" ] ],
    [ "dht:SDA", "esp:D4",    "green",  [ "v20", "h120", "*", "h-20" ] ],

    [ "rPullup:1", "dht:SDA", "green",  [ "v0", "*", "v-10" ] ],
    [ "rPullup:2", "dht:VCC", "red",    [ "v0", "*", "v-10" ] ]
  ],
  "dependencies": {}
}
